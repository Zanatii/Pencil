# ── JIRA ──────────────────────────────────────────────────────────────────────
JIRA_URL=https://jira.example.com
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_AUTH_TYPE=bearer

# ── Proxi (Claude-via-Chrome bridge service) ─────────────────────────────────
PROXI_URL=http://127.0.0.1:4001

# ── PO Agent backend ──────────────────────────────────────────────────────────
# Documentation only — main.py doesn't read this. Uvicorn is started via the
# CLI (see po-start alias / api/main.py docstring), so this just records what
# port that command should use; --port is what actually controls it.
PORT=8010
